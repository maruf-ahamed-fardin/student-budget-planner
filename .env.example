# Copy to .env.local for local overrides. Every variable is optional.

# Where the SQLite file lives. Point it at a persistent volume in production.
# Default: ./data/budget.db
DATABASE_PATH=

# How many reverse proxies sit in front of the app, used to find the real
# client IP for rate limiting. 1 = Render, Railway, Fly or a single nginx.
# 2 = Cloudflare in front of nginx. Default: 1
TRUSTED_PROXY_HOPS=1

# Build-time. Extra hosts allowed to submit forms (Server Actions), only if a
# proxy rewrites the Host header. Comma-separated, e.g. budget.example.com
SERVER_ACTIONS_ALLOWED_ORIGINS=

# Port and interface for `node server.js` / `next start`.
PORT=3000
HOSTNAME=0.0.0.0
